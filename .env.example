# Decider backend selection: mock | local | remote
DECIDER_BACKEND=mock
# Remote decider endpoint (when DECIDER_BACKEND=remote)
DECIDER_URL=http://localhost:8000
# Decider model checkpoint
DECIDER_MODEL_ID=StrandsAgents/strands-decider-2B-hobson-v19
# Decider inference device: cpu | cuda (GPU hosts use cuda)
DECIDER_DEVICE=cpu
# Offline Hugging Face Hub mode (default false)
HF_OFFLINE=false

# Bedrock generation settings
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_REGION=us-east-1
# Run without AWS credentials in mock mode (1=enabled, 0=live Bedrock)
MOCK_BEDROCK=1

# Storage and Caches
HF_HOME=E:\hf-cache
CONFIG_PATH=config.yaml

